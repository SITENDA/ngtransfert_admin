// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

generator zod {
  provider       = "zod-prisma-types"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL") // uses connection pooling
  // directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum Role {
  ADMIN
  AGENT
  CLIENT
  ENGINEER
  MANAGER
}

enum ReceiverAccountType {
    ALIPAY_ACCOUNT
    WECHAT_ACCOUNT
    BANK_ACCOUNT
}

enum ReceiverAccountIdentifier {
    EMAIL
    PHONE_NUMBER
    QR_CODE_IMAGE
    NONE
}

enum RateSource {
  FIXER_IO
  OPEN_EXCHANGE_RATES
  XE_COM
  NGTRANSFERT_RATES
}


model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT) // Default role is CLIENT
  accounts      Account[]
  sessions      Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receiverAccounts ReceiverAccount[] // Back relation to ReceiverAccount

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages") // Optional: map to a different table name
}


model Language {
  id    String @id @default(cuid()) @map("language_id")
  code  String @map("language_code")
  name  String @map("language_name")

  countries Country[] // Added for relation from Currency to Country

  @@map("language")
}

model Country {
  id            String    @id @default(cuid()) @map("country_id")
  name          String    @map("country_name")
  continent     String    @map("continent")
  flagUrl       String?   @map("country_flag_url")
  currency      Currency? @relation(fields: [currencyId], references: [id])
  language      Language? @relation(fields: [languageId], references: [id])
  currencyId    String?
  languageId    String?
  banks         Bank[]    // Back relation to Bank (now an array)
  adminPercentages AdminPercentage[] // Back relation to AdminPercentage
  cashDepositAddresses CashDepositAddress[] // Back relation to CashDepositAddress

  @@map("country")
}

model Bank {
  id            String    @id @default(cuid()) @map("bank_id")
  name          String    @map("bank_name")
  nameEng       String?   @map("bank_name_eng")
  shortName     String?   @map("bank_short_name")
  logoUrl       String?   @map("bank_logo_url")
  country       Country?  @relation(fields: [countryId], references: [id]) // Relation is optional on Bank side
  countryId     String?   @map("country_id")

  receiverAccounts ReceiverAccount[] // Back relation to ReceiverAccount
  bankDepositAddresses BankDepositAddress[] // Back relation to BankDepositAddress

  @@map("bank")
}

model ReceiverAccount {
  id                  String      @id @default(cuid()) @map("receiver_account_id")
  name                String?     @map("receiver_account_name") // Name is optional
  type                ReceiverAccountType @map("receiver_account_type")
  client              User        @relation(fields: [clientId], references: [id])
  clientId            String      @map("client_id")
  identifier          ReceiverAccountIdentifier @map("receiver_account_identifier")
  qrCodeUrl           String?     @map("qr_code_url")
  qrCodeContent       String?     @unique @map("qr_code_content") // qrCodeContent is unique and optional
  email               String?     @unique @map("email") // Email is unique and optional
  phoneNumber         String?     @unique @map("phone_number") // Phone number is unique and optional
  balance             Decimal     @map("balance") // Use Decimal type for MonetaryAmount
  bankAccountNumber   String?     @map("bank_account_number") // Bank account number as String
  bank                Bank?       @relation(fields: [bankId], references: [id])
  bankId              String?     @map("bank_id")
  limit               Decimal     @map("limit") // Use Decimal type for MonetaryAmount


  @@map("receiver_account")
}

model AdminPercentage {
  id        String      @id @default(cuid()) @map("admin_percentage_id")
  country   Country     @relation(fields: [countryId], references: [id])
  countryId String      @map("country_id")
  percentage Decimal     @map("percentage")

  @@unique([countryId, percentage]) // Unique constraint on countryId and percentage

  @@map("admin_percentage")
}

model BankDepositAddress {
  id        String   @id @default(cuid()) @map("bank_deposit_address_id")
  address   String   @map("address")
  bank      Bank?    @relation(fields: [bankId], references: [id])
  bankId    String?  @map("bank_id")

  @@unique([address, bankId]) // Composite unique constraint

  @@map("bank_deposit_address")
}

model CashDepositAddress {
  id        String   @id @default(cuid()) @map("cash_deposit_address_id")
  address   String   @map("address")
  country   Country  @relation(fields: [countryId], references: [id])
  countryId String   @map("country_id")

  @@unique([address, countryId]) // Composite unique constraint

  @@map("cash_deposit_address")
}

model ExchangeRate {
  id             String    @id @default(cuid()) @map("exchange_rate_id")
  rateValue      Decimal   @map("rate_value")
  lastUpdated    DateTime  @map("last_updated") @default(now()) // Add default now()
  source         RateSource @map("source")
  sourceCurrency Currency  @relation(fields: [sourceCurrencyId], references: [id], name: "SourceCurrency")
  sourceCurrencyId String @map("source_currency_id")
  targetCurrency Currency  @relation(fields: [targetCurrencyId], references: [id], name: "TargetCurrency")
  targetCurrencyId String @map("target_currency_id")

  @@map("exchange_rate")
  @@unique([sourceCurrencyId, targetCurrencyId]) // Ensure unique pairs
}

model Currency {
  id             String         @id @default(cuid()) @map("currency_id")
  code           String         @unique @map("currency_code")
  name           String         @unique @map("currency_name")
  symbol         String?        @map("currency_symbol")
  sourceExchangeRates ExchangeRate[] @relation("SourceCurrency")
  targetExchangeRates ExchangeRate[] @relation("TargetCurrency")

  countries           Country[]            // Added reverse relation here

  @@map("currency")
}